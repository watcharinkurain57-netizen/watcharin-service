# คัดลอกเป็น .env.local แล้วเติมค่าจริง
# ค่าเอาจาก Supabase dashboard → Settings → API Keys

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# อีเมลติดต่อ (มีอยู่เดิม)
RESEND_API_KEY=
RESEND_FROM=

# ⚠️ อย่าตั้งชื่อคีย์ลับให้ขึ้นต้นด้วย NEXT_PUBLIC_ เพราะ Next จะฝังลง bundle
# ฝั่งเบราว์เซอร์ให้ทุกคนอ่านได้ คีย์ลับใช้ชื่อแบบนี้แทน แล้วเรียกจากเซิร์ฟเวอร์เท่านั้น
# SUPABASE_SECRET_KEY=
